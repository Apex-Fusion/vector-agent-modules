# One marketplace gateway API key per juror (SPEC §13). The variable names
# are the api_key_env values of jurors/foundation/jurors.json. Copy this file
# to gateway-keys.env (mode 600, never commit it) and fill in the keys.
JURY_GATEWAY_KEY_DS_FLASH_CHAT_1=
JURY_GATEWAY_KEY_DS_FLASH_CHAT_2=
JURY_GATEWAY_KEY_DS_FLASH_CHAT_3=
JURY_GATEWAY_KEY_KIMI_CHAT_2=
JURY_GATEWAY_KEY_KIMI_CHAT_3=
